# Docker image tag (compose builds/pushes fraud-detection:${IMAGE_TAG:-latest})
# IMAGE_TAG=latest

# HTTP server (run.py / Docker)
PORT=5050
HOST=0.0.0.0
DEBUG=0

# SQLite path (default in repo: affiliate_data.db). In Docker compose, DB_PATH=/data/affiliate_data.db
DB_PATH=affiliate_data.db

# Optional: path to config.json when not using cwd default
# CONFIG_PATH=config.json

# Set to 1 when running `python scheduler.py` separately so the web app does not embed APScheduler.
# Docker Compose `web` service sets this automatically.
# SKIP_EMBEDDED_SCHEDULER=1

# Gunicorn (Docker / production). Use 1 worker with SQLite unless you know write patterns are safe.
# WEB_CONCURRENCY=1
# GUNICORN_TIMEOUT=120

# Required in Docker/production: encrypts per-user admin2 session tokens (generate once, keep secret).
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Fail startup when FLASK_SECRET_KEY is empty (set to 1 in production compose/Portainer).
# REQUIRE_FLASK_SECRET_KEY=1

# Session cookie flags (Secure requires HTTPS at the browser / TLS terminator).
# SESSION_COOKIE_SECURE=1
# TRUST_PROXY_HTTPS=1
# SESSION_COOKIE_SAMESITE=Lax

# Require valid admin2 sign-in to use the dashboard API (1=yes, 0=off for local dev).
ADMIN2_LOGIN_REQUIRED=1
# Same gate; set 0 only to override when LOGIN_REQUIRED is still 1.
# ADMIN2_GATE_DASHBOARD=1

# Scheduler-only: background enrichment (web UI uses per-user session login, not these).
ADMIN_API_USERNAME=
ADMIN_API_PASSWORD=

# Logging: text (default) or json lines; stdout-only avoids growing files in containers.
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# LOG_TO_STDOUT_ONLY=1
# LOG_FILE=fraud_detection.log
# LOG_MAX_BYTES=10000000
# LOG_BACKUP_COUNT=5

# Backup script (scripts/backup_sqlite.py)
# BACKUP_DIR=backups
# BACKUP_KEEP=30

# macOS only: User Notifications for pipeline failures / stale schedule (0 disables even if enabled in config).
# FRAUD_NOTIFY_MACOS=1

# Affiliate data export API (hugetraffic / platform). Overrides config.json api_key when set.
FRAUD_DETECTION_API_KEY=

# Bearer token for POST /api/webhook/ingest. Overrides config.json webhook_ingest_token when set.
WEBHOOK_INGEST_TOKEN=

# PS7 source reconciliation via MCP HTTP (preferred over raw Elasticsearch credentials).
# Set mcp_url in config.json scheduler.mcp_reconciliation, or override here:
# CAMSODA_MCP_URL=http://ded30025.ded.reflected.net:3000/mcp
CAMSODA_MCP_AUTH=
